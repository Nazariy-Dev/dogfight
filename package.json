{
  "name": "dogfight",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:server": "node --env-file-if-exists=.env --watch server/src/index.js",
    "build": "npm run build -w client",
    "start": "node server/src/index.js",
    "test": "npm test --workspaces",
    "lint": "eslint .",
    "format": "prettier --write client server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  }
}
